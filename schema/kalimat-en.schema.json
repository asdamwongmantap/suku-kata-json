{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kalimat-en.schema.json",
  "title": "Kalimat (Inggris)",
  "description": "Kalimat sederhana bahasa Inggris untuk latihan membaca.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "teks",
      "kata",
      "jumlah_kata",
      "level"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z]+(-[a-z]+)*$"
      },
      "teks": {
        "type": "string",
        "minLength": 1
      },
      "kata": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z]+$"
        }
      },
      "jumlah_kata": {
        "type": "integer",
        "minimum": 1
      },
      "level": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    }
  }
}
