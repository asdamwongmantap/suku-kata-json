{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "suku-kata-en.schema.json",
  "title": "Suku Kata (Inggris)",
  "description": "Daftar suku kata (syllable) bahasa Inggris yang dipakai pada kata-en.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "teks",
      "level",
      "contoh_kata"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z]+$"
      },
      "teks": {
        "type": "string",
        "pattern": "^[a-z]+$"
      },
      "level": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "contoh_kata": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "string",
          "pattern": "^[a-z]+$"
        }
      }
    }
  }
}
